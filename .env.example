# ==== Runtime ====
# Port the Express server listens on (default: 3000)
PORT="3000"
# Set to "production" when running `npm run build && npm start`
NODE_ENV="development"

# ==== Admin authentication ====
# Admin accounts live in MongoDB and are managed from the admin panel
# (Dashboard -> "অ্যাডমিন ব্যবস্থাপনা"). There are NO built-in / demo accounts.
#
# The first account is created automatically on startup when the admins
# collection is empty. Set these three values, start the server once, then
# create/edit/delete every other admin from the panel.
BOOTSTRAP_ADMIN_NAME="Site Administrator"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Secret used to sign the JWT issued after login. REQUIRED in production
# (min. 16 characters); in development a random one is generated per restart.
JWT_SECRET="replace_with_a_long_random_string"

# ==== Database (required for the admin panel) ====
# MongoDB connection string. Admin accounts are stored here; site content is
# persisted to data/store.json on disk.
MONGODB_URI=""

# ==== File storage (optional) ====
# When set, all image/video/PDF uploads go to Cloudinary instead of local disk.
# Videos uploaded from a device are sent with chunked upload_large, so large
# files work; if Cloudinary is unreachable the upload falls back to local disk.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative single-string form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Maximum size (MB) of a single uploaded file (video / image / PDF). Default 512.
MAX_UPLOAD_MB="512"
