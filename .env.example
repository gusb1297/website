# ── Admin & auth ───────────────────────────────────────────────────────────
# Secret used to sign admin JWTs. Set it to any long random string in
# production, and to the SAME value across restarts.
JWT_SECRET=

# First admin account, created automatically when the admins collection is
# empty (min. 8 characters for the password). Optional but recommended.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ── Database ────────────────────────────────────────────────────────────────
# Required in production: admin accounts AND all site content (news, gallery,
# videos, settings, job applications…) live in MongoDB.
MONGODB_URI=

# ── File storage: Cloudinary (required) ─────────────────────────────────────
# Every uploaded file — images, videos, PDFs and applicant CVs — is stored in
# Cloudinary. There is deliberately NO local-disk fallback: on Render / Heroku /
# Railway the disk is wiped on every restart, which is how uploaded pictures
# used to disappear.
#
# Cloudinary → Dashboard → Settings → "Access Keys" (the free tier is plenty).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional alternative to the three variables above, e.g.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@my-cloud
# (Any folder written into that URL is ignored — this app always files uploads
# under CLOUDINARY_FOLDER/<kind>, see below.)
# CLOUDINARY_URL=

# Uploads are filed under this folder prefix, then a sub-folder per kind
# (gallery / hero / programs / news / videos / thumbnails / logos / documents /
# career). Left empty it falls back to "vdo_bogura".
# CLOUDINARY_FOLDER=vdo_bogura

# ── Upload limits (MB) ──────────────────────────────────────────────────────
# Defaults are shown; only change them if you really need to.
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=512
MAX_DOCUMENT_UPLOAD_MB=25
MAX_APPLICATION_UPLOAD_MB=5
