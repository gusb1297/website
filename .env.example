# ── Admin & auth ───────────────────────────────────────────────────────────
# Secret used to sign admin JWTs. Set it to any long random string in
# production, and to the SAME value across restarts.
JWT_SECRET=

# First admin account, created automatically when the admins collection is
# empty (min. 8 characters for the password). Optional but recommended.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ── Database ────────────────────────────────────────────────────────────────
# Required: admin accounts AND all site content (hero slides, programs, news,
# gallery, videos, settings, page copy, job applications…) live in MongoDB —
# every record is a document in its own collection (heroslides, programs,
# newsitems, videos, notices, publications, galleryalbums, galleryphotos,
# committeemembers, partners, careers, applications, stats, sitesettings,
# pagecontents). Nothing is ever written to the server's own disk, so a deploy
# cannot wipe content. Without MONGODB_URI no edit can be saved (the admin
# panel answers 503 instead of pretending to save).
MONGODB_URI=

# Database name used when the URI does not contain one (default: gusb).
# MONGODB_DB=gusb

# ── Automatic content backups ───────────────────────────────────────────────
# Point-in-time snapshots of the whole site content. Stored in the
# `contentbackups` MongoDB collection AND mirrored to AM Storage, so the site
# can be brought back even if the database is wiped. On boot, an empty database
# is refilled from the newest snapshot automatically.
# BACKUP_ENABLED=true              # set to false to switch the snapshots off
# BACKUP_INTERVAL_MINUTES=360      # one snapshot at least every 6 hours
# BACKUP_MIN_INTERVAL_MINUTES=30   # never more than one snapshot per 30 min after edits
# BACKUP_KEEP=40                   # how many snapshots are kept (manual ones are pinned)
# BACKUP_MIRROR_AM_STORAGE=true    # false = keep snapshots in MongoDB only

# ── File storage: Cloudinary (images & videos) ──────────────────────────────
# Every uploaded picture and video is stored in Cloudinary (PDFs and other
# documents go to the AM Storage gateway, see the next section). There is deliberately NO local-disk fallback: on Render / Heroku /
# Railway the disk is wiped on every restart, which is how uploaded pictures
# used to disappear.
#
# Cloudinary → Dashboard → Settings → "Access Keys" (the free tier is plenty).
# Paste the bare values. Stray quotes, spaces, a trailing comma or a pasted
# "NAME=" prefix are stripped automatically (the admin banner lists what was
# corrected), and the admin banner says exactly which value Cloudinary rejects.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional alternative to the three variables above, e.g.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@my-cloud
# (Any folder written into that URL is ignored — this app always files uploads
# under CLOUDINARY_FOLDER/<kind>, see below.)
# CLOUDINARY_URL=

# Uploads are filed under this folder prefix, then a sub-folder per kind
# (gallery / hero / programs / news / videos / thumbnails / logos / documents /
# career). Left empty it falls back to "vdo_bogura".
# CLOUDINARY_FOLDER=vdo_bogura

# ── Document storage: AM Storage bridge (PDF, DOC, DOCX, TXT, applicant CVs) ─
# Cloudinary cannot serve this site's PDFs, so every document is pushed
# server-side to the AM Storage gateway. The three values below default to the
# credentials issued for this site (see server/services/amStorage.ts); set them
# here to override / rotate them without a code change.
# AM_STORAGE_BRIDGE_URL=https://st.thamjj13.top/api/v1
# AM_STORAGE_KEY_ID=ng_key_…
# AM_STORAGE_KEY_SECRET=ng_live_…
# "dual" (default: key id + secret headers) or "hmac" (signed requests, the
# secret is never transmitted).
# AM_STORAGE_AUTH_MODE=dual

# ── Upload limits (MB) ──────────────────────────────────────────────────────
# Defaults are shown; only change them if you really need to.
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=512
MAX_DOCUMENT_UPLOAD_MB=25
MAX_APPLICATION_UPLOAD_MB=5
