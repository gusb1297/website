# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign JSON Web Tokens for Admin Authentication
JWT_SECRET="palli_unnayan_sangstha_secret_key_2026"

# MONGODB_URI: Connection string for MongoDB database (Optional: falls back to in-memory data store if not provided)
MONGODB_URI=""

# Cloudinary image storage credentials (Optional: direct image upload via Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
