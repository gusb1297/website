# ==== Runtime ====
# Port the Express server listens on (default: 3000)
PORT="3000"
# Set to "production" when running `npm run build && npm start`
NODE_ENV="development"

# ==== Admin authentication ====
# Admin accounts live in MongoDB. There are NO built-in / demo accounts, and
# you should NOT insert users from the MongoDB Atlas panel (plaintext
# passwords will never log in — the app stores bcrypt hashes).
#
# How to create the first administrator (pick ONE):
#   1. Fill the three BOOTSTRAP_* values below and start the server once, OR
#   2. Start the server with only MONGODB_URI set, then open /admin/login
#      and use the first-run form, OR
#   3. npm run create-admin -- --email you@org.org --password 'strong-pass'
#
# After the first account exists, add more from /admin → অ্যাডমিন ব্যবস্থাপনা.
BOOTSTRAP_ADMIN_NAME="Site Administrator"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Secret used to sign the JWT issued after login. REQUIRED in production
# (min. 16 characters); in development a random one is generated per restart.
JWT_SECRET="replace_with_a_long_random_string"

# ==== Database (required for the admin panel) ====
# MongoDB Atlas / local connection string.
# Include a database name in the path (…mongodb.net/gusb?…) so accounts are
# not written to the default "test" database. If the URI has no db name,
# MONGODB_DB (default: gusb) is used.
#
# Atlas checklist when login says the database is unreachable:
#   • Network Access → allow this server's IP, or 0.0.0.0/0 for testing
#   • Database Access → user/password must match the URI
#   • URL-encode special characters in the password (@ # % : /)
MONGODB_URI=""
MONGODB_DB="gusb"

# ==== File storage (optional) ====
# When set, all image/video/PDF uploads go to Cloudinary instead of local disk.
# Videos uploaded from a device are sent with chunked upload_large, so large
# files work; if Cloudinary is unreachable the upload falls back to local disk.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative single-string form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Maximum size (MB) of a single uploaded file (video / image / PDF). Default 512.
MAX_UPLOAD_MB="512"
