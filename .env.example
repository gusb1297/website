# ==== Runtime ====
# Port the Express server listens on (default: 3000)
PORT="3000"
# Set to "production" when running `npm run build && npm start`
NODE_ENV="development"

# ==== Admin authentication ====
# Comma-separated admin emails / passwords allowed to log in to /admin.
# If not set, the demo credentials are used (see README).
ADMIN_EMAILS="admin@vdobogura.org"
ADMIN_PASSWORDS="change-me-strong-password"
# Secret used to sign the JWT issued after login. ALWAYS set a long random value in production.
JWT_SECRET="replace_with_a_long_random_string"

# ==== Persistence (optional) ====
# MongoDB connection string. The content management layer currently persists
# to data/store.json on disk; this connection is established for future use.
MONGODB_URI=""

# ==== File storage (optional) ====
# When set, all image/video/PDF uploads go to Cloudinary instead of local disk.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
