# ==== Runtime ====
# Port the Express server listens on (default: 3000)
PORT="3000"
# Set to "production" when running `npm run build && npm start`
NODE_ENV="development"

# ==== Admin authentication ====
# Admin accounts live in MongoDB. There are NO built-in / demo accounts, and
# you should NOT insert users from the MongoDB Atlas panel (plaintext
# passwords will never log in — the app stores bcrypt hashes).
#
# How to create the first administrator (pick ONE):
#   1. Fill the three BOOTSTRAP_* values below and start the server once, OR
#   2. Start the server with only MONGODB_URI set, then open /admin/login
#      and use the first-run form, OR
#   3. npm run create-admin -- --email you@org.org --password 'strong-pass'
#
# After the first account exists, add more from /admin → অ্যাডমিন ব্যবস্থাপনা.
BOOTSTRAP_ADMIN_NAME="Site Administrator"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Secret used to sign the JWT issued after login. REQUIRED in production
# (min. 16 characters); in development a random one is generated per restart.
JWT_SECRET="replace_with_a_long_random_string"

# ==== Database (REQUIRED — admin accounts + ALL site content) ====
# MongoDB Atlas / local connection string.
# Every admin edit (hero slides, news, gallery records, settings, …) is saved
# in the `sitecontents` collection of this database. Hosts like Render /
# Heroku / Railway wipe the local disk on every deploy, so without MongoDB
# the content only lives in data/store.json and disappears on the next update.
# Include a database name in the path (…mongodb.net/gusb?…) so data is
# not written to the default "test" database. If the URI has no db name,
# MONGODB_DB (default: gusb) is used.
#
# Atlas checklist when login says the database is unreachable:
#   • Network Access → allow this server's IP, or 0.0.0.0/0 for testing
#   • Database Access → user/password must match the URI
#   • URL-encode special characters in the password (@ # % : /)
MONGODB_URI=""
MONGODB_DB="gusb"

# ==== File storage (REQUIRED in production / on Render, Heroku, Railway…) ====
# All image/video/PDF uploads go to Cloudinary (free tier is enough to start:
# https://cloudinary.com → Dashboard → "API Keys"). Files written to the local
# disk of an ephemeral host are DELETED on every deploy/restart, so in
# production (or when REQUIRE_CLOUD_STORAGE=true) an upload is refused with a
# clear error instead of being silently written to a disk that will vanish.
# Videos uploaded from a device are sent with chunked upload_large, so large
# files work.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Alternative single-string form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
# Force / relax the "uploads must go to Cloudinary" rule. Default: true when
# NODE_ENV=production or a Render/Heroku/Railway/Fly/Vercel host is detected,
# false otherwise (local development keeps files in ./uploads).
# Set to "false" only on a VPS whose ./uploads directory is a persistent disk.
REQUIRE_CLOUD_STORAGE=""

# Maximum size (MB) of a single general upload (video / image / PDF). Default 512.
MAX_UPLOAD_MB="512"
# Stricter per-file limit for Photo Gallery images. Default 10 MB.
MAX_IMAGE_UPLOAD_MB="10"
